# ==========================================
# Shopify Store Credentials
# ==========================================
# مثال: my-store.myshopify.com (بدون https://)
SHOPIFY_STORE_URL=your-store.myshopify.com

# توكن الـ Admin API (يبدأ بـ shpat_)
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-04

# ==========================================
# Google Gemini AI API Key
# ==========================================
# يمكنك استخراجه مجاناً من Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# Telegram Bot Configuration
# ==========================================
# التوكن المستخرج من @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# معرفات تيليجرام المسموح لها بإرسال أوامر للبوت (اختياري، مفصولة بفواصل)
# يمكنك معرفة الـ ID الخاص بك عبر بوت @userinfobot
TELEGRAM_ALLOWED_USER_IDS=

# ==========================================
# Server Settings
# ==========================================
HOST=127.0.0.1
PORT=8000
